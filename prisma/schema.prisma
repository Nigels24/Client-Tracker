// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WORK_STATUS {
  PENDING
  IN_PROGRESS
  REVISIONS
  DONE
}

enum PROJECT_TYPE {
  SYSTEM
  DOCU
  BOTH
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  clients      Client[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  school String?
  course String?
  notes  String?

  projectType PROJECT_TYPE @default(SYSTEM)
  status      WORK_STATUS  @default(PENDING)

  // Whole pesos, never centavos. See lib/money.ts.
  systemPrice Int?
  docuPrice   Int?

  // Whoever referred this client takes `partnerSharePercent` of the SYSTEM
  // price only — docu work is always kept in full. No name means no cut.
  partnerName         String?
  partnerSharePercent Int     @default(0)

  systemDueDate DateTime?
  docuDueDate   DateTime?

  members   ClientMember[]
  tasks     Task[]
  payments  Payment[]
  documents ClientDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ClientMember {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name    String
  contact String?
  // 0 is the main contact — the one you actually message.
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Task {
  id        Int         @id @default(autoincrement())
  clientId  Int
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  status    WORK_STATUS @default(PENDING)
  dueDate   DateTime?
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([clientId])
}

model Payment {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Whole pesos, never centavos. See lib/money.ts.
  amount    Int
  paidAt    DateTime
  label     String?
  method    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientDocument {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label    String @default("Agreement")
  fileName String
  mimeType String
  size     Int

  // Vercel Blob. `access` records whether the blob is private (streamed back
  // through /api/documents/[id]/view) or public (redirected to). `pathname` is
  // what del() needs to remove the underlying file.
  url      String
  pathname String
  access   String @default("private")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}
